# Postgres connection (docker-compose sets this automatically for the backend service)
DATABASE_URL=postgres://tcg:tcg@localhost:5432/tcg_events

# Search origin + radius (km, applies to both MTG and FAB sources) — tune
# the corridor without touching code
ORIGIN_QUERY=Timisoara, Romania
RADIUS_KM=500

# Optional. fabtcg.com blocks requests from known hosting/datacenter IPs
# (bare 403, not a header issue). Leave blank to connect directly; set to an
# HTTP/HTTPS/SOCKS proxy URL with a non-datacenter exit IP if FAB events
# aren't syncing from a server deploy.
FAB_PROXY_URL=
